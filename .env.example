# ReconStack environment template
# Copy to .env and replace placeholder values.

# === Required for paid API-backed servers ===
SHODAN_API_KEY=your_shodan_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key
DEHASHED_API_KEY=your_dehashed_api_key
GOOGLE_API_KEY=your_google_api_key
GOOGLE_CSE_ID=your_programmable_search_engine_id
SHERLOCKEYE_API_KEY=your_sherlockeye_api_key
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# === Optional provider/API keys ===
GITHUB_TOKEN=your_github_token
OPENCORPORATES_API_KEY=your_opencorporates_api_key
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key
DEHASHED_EMAIL=your_dehashed_account_email

# === Optional dorking backends ===
BING_API_KEY=your_bing_api_key
SERPAPI_KEY=your_serpapi_key
BRAVE_API_KEY=your_brave_api_key
DORKER_CACHE_DIR=/tmp/dorker_cache
DORKER_CACHE_TTL=24
DORKER_EXPORT_DIR=/tmp/dorker_exports

# === Neo4j server settings ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
SQLITE_DB_PATH=/path/to/source.sqlite

# === Backward-compatible aliases (optional) ===
GOOGLE_CX=your_programmable_search_engine_id
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash
URBAN_SCOUT_API_KEY=your_google_maps_api_key
VT_API_KEY=your_virustotal_api_key
